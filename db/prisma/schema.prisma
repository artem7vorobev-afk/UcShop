generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum OrderStatus {
  NEW
  AWAITING_PAYMENT
  PAID
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentProvider {
  MOCK
  SBP
}

model User {
  id                String   @id @default(cuid())
  telegramId        String?  @unique
  telegramUsername  String?
  firstName         String?
  lastName          String?
  email             String?  @unique
  password          String?
  role              UserRole @default(USER)
  referralCode      String?  @unique
  referredBy        String?
  balance           Decimal  @default(0) @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  phone             String?
  referralEarnings  Decimal  @default(0) @db.Decimal(10, 2)

  orders            Order[]
  payments          Payment[]
  auditLogs         AuditLog[]
  referrals         Referral[]            @relation("Referrer")
  referredUsers     Referral[]            @relation("ReferredUser")
  referralTransactions ReferralTransaction[]

  @@index([telegramId])
  @@index([email])
  @@index([referralCode])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([email])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  imageUrl    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@index([order])
}

model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  categoryId  String
  name        String
  description String?
  imageUrl    String?
  isActive    Boolean        @default(true)
  isFeatured  Boolean        @default(false)
  order       Int            @default(0)
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  category    Category       @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  orderItems  OrderItem[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  name            String
  price           Decimal  @db.Decimal(10, 2)
  originalPrice   Decimal? @db.Decimal(10, 2)
  currency        String   @default("RUB")
  isActive        Boolean  @default(true)
  stock           Int      @default(-1)
  metadata        Json?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product  @relation(fields: [productId], references: [id])
  orderItems      OrderItem[]

  @@index([productId])
  @@index([isActive])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String?     @unique
  userId          String
  telegramId      String?
  status          OrderStatus @default(NEW)
  totalAmount     Decimal     @db.Decimal(10, 2)
  currency        String      @default("RUB")
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal     @db.Decimal(10, 2)
  promoCodeId     String?
  orderData       Json?
  metadata        Json?
  receipt         String?
  receiptFormat   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payment         Payment?
  promoCode       PromoCode?  @relation(fields: [promoCodeId], references: [id])
  referralTransactions ReferralTransaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  productId       String
  variantId       String
  quantity        Int             @default(1)
  price           Decimal         @db.Decimal(10, 2)
  itemData        Json?
  deliveryId      String?
  deliveryDetails Json?
  deliveryStatus  String          @default("PENDING")
  deliveredAt     DateTime?
  createdAt       DateTime        @default(now())

  order           Order           @relation(fields: [orderId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant  @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String          @unique
  userId            String?
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("RUB")
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider @default(MOCK)
  providerPaymentId String?         @unique
  providerData      Json?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  order           Order           @relation(fields: [orderId], references: [id])
  user            User?           @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([providerPaymentId])
}

model Banner {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  imageUrl             String?
  linkUrl              String?
  order                Int      @default(0)
  priority             Int      @default(0)
  isActive             Boolean  @default(true)
  targetAudience       String   @default("ALL")
  applicableCategories String[]
  applicableProducts   String[]
  viewsCount           Int      @default(0)
  clicksCount          Int      @default(0)
  startDate            DateTime?
  endDate              DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@index([priority])
}

model PromoCode {
  id                   String       @id @default(cuid())
  code                 String       @unique
  discountType         DiscountType
  discountValue        Decimal      @db.Decimal(10, 2)
  maxUses              Int?
  usesCount            Int          @default(0)
  minOrderAmount       Decimal?     @db.Decimal(10, 2)
  expiresAt            DateTime?
  applicableProducts   String[]
  applicableCategories String[]
  isActive             Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  orders               Order[]

  @@index([code])
  @@index([isActive])
}

model Referral {
  id             String    @id @default(cuid())
  referrerId     String
  referredUserId String    @unique
  status         String    @default("ACTIVE")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  referrer       User      @relation("Referrer", fields: [referrerId], references: [id])
  referredUser   User      @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@index([referrerId])
  @@index([status])
}

model ReferralTransaction {
  id         String   @id @default(cuid())
  referrerId String
  orderId    String?
  amount     Decimal  @db.Decimal(10, 2)
  type       String
  createdAt  DateTime @default(now())

  referrer   User     @relation(fields: [referrerId], references: [id])
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([referrerId])
  @@index([orderId])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  adminId     String?
  action      String
  entity      String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])
  admin       Admin?   @relation(fields: [adminId], references: [id])

  @@index([userId])
  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
}
